---
import BaseLayout from "../layouts/BaseLayout.astro";
import { site } from "../config/site";
import Button from "../components/ui/Button.astro";
import Eyebrow from "../components/ui/Eyebrow.astro";
import { formatNumber, resolveUi } from "../lib/i18n";
import { base } from "../lib/url";

const ui = resolveUi(site);
const backLabel = ui.notFound.back.replace("{brand}", site.brand.name);
---

<BaseLayout
  title={`${ui.notFound.title} — ${site.brand.name}`}
  description={ui.notFound.body}
  noindex
>
  <section class="section" aria-labelledby="not-found-title">
    <div class="shell not-found">
      <Eyebrow text={ui.notFound.eyebrow} />
      <p class="not-found__code" aria-hidden="true">
        {formatNumber(404, site.meta.locale, { useGrouping: false })}
      </p>
      <div class="not-found__body">
        <h1 id="not-found-title" class="display display--md">
          {ui.notFound.title}
        </h1>
        <p class="lede mt-4">{ui.notFound.body}</p>
      </div>
      <div>
        <Button href={base} label={backLabel} variant="accent" />
      </div>
    </div>
  </section>
</BaseLayout>
