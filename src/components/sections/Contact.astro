---
import type { SiteConfig } from "../../config/types";
import Eyebrow from "../ui/Eyebrow.astro";
import HeadlineText from "../ui/Headline.astro";
import Icon from "../ui/Icon.astro";
import Section from "../ui/Section.astro";
import { resolveUi } from "../../lib/i18n";

interface Props {
  site: SiteConfig;
}

const { site } = Astro.props;
const contact = site.contact;
const ui = resolveUi(site);
---

{
  contact && (
    <Section id="contact" labelledby="contact-title" tone="surface" class="contact">
      <div class="contact__layout">
        <div class="contact__intro">
          <Eyebrow text={contact.eyebrow} />
          <h2 id="contact-title" class="display display--lg">
            <HeadlineText headline={contact.headline} />
          </h2>
          <p class="lede">{contact.intro}</p>

          <div class="contact__details">
            <div class="contact-item">
              <span class="contact-item__icon" aria-hidden="true">
                <Icon name="mail" size={17} />
              </span>
              <div>
                <p class="contact-item__label">{ui.contactDetails.email}</p>
                <a
                  class="contact-item__value contact__email"
                  href={`mailto:${contact.details.email}`}
                >
                  <bdi dir="ltr">{contact.details.email}</bdi>
                </a>
              </div>
            </div>

            <div class="contact-item">
              <span class="contact-item__icon" aria-hidden="true">
                <Icon name="map-pin" size={17} />
              </span>
              <div>
                <p class="contact-item__label">{ui.contactDetails.address}</p>
                <p class="contact-item__value">{contact.details.address}</p>
              </div>
            </div>

            <div class="contact-item">
              <span class="contact-item__icon" aria-hidden="true">
                <Icon name="clock" size={17} />
              </span>
              <div>
                <p class="contact-item__label">{ui.contactDetails.hours}</p>
                <p class="contact-item__value">{contact.details.hours}</p>
              </div>
            </div>

            {contact.details.phone && (
              <div class="contact-item">
                <span class="contact-item__icon" aria-hidden="true">
                  <Icon name="phone" size={17} />
                </span>
                <div>
                  <p class="contact-item__label">{ui.contactDetails.phone}</p>
                  <a
                    class="contact-item__value"
                    href={`tel:${contact.details.phone.replace(/\s/g, "")}`}
                  >
                    <bdi dir="ltr">{contact.details.phone}</bdi>
                  </a>
                </div>
              </div>
            )}
          </div>
        </div>

        <div class="contact__form-wrap">
          <h3 class="display display--sm">{contact.form.title}</h3>
          <p class="demo-note" id="form-note">{contact.form.note}</p>

          <form
            class="contact__form"
            data-demo-form
            data-success={contact.form.success}
            data-success-fallback={ui.form.successFallback}
            aria-describedby="form-note"
          >
            <div class="form-grid">
              <div class="field">
                <label class="field__label" for="contact-name">{ui.form.name}</label>
                <input
                  class="field__input"
                  id="contact-name"
                  name="name"
                  type="text"
                  autocomplete="name"
                  maxlength="80"
                  required
                />
              </div>

              <div class="field">
                <label class="field__label" for="contact-email">{ui.form.email}</label>
                <input
                  class="field__input"
                  id="contact-email"
                  name="email"
                  type="email"
                  autocomplete="email"
                  inputmode="email"
                  autocapitalize="off"
                  spellcheck="false"
                  dir="ltr"
                  maxlength="120"
                  required
                />
              </div>

              {contact.form.kind === "booking" ? (
                <>
                  <div class="field">
                    <label class="field__label" for="contact-arrival">{ui.form.arrival}</label>
                    <input
                      class="field__input"
                      id="contact-arrival"
                      name="arrival"
                      type="date"
                      lang={site.meta.locale}
                    />
                  </div>
                  <div class="field">
                    <label class="field__label" for="contact-departure">{ui.form.departure}</label>
                    <input
                      class="field__input"
                      id="contact-departure"
                      name="departure"
                      type="date"
                      lang={site.meta.locale}
                    />
                  </div>
                  <div class="field field--full">
                    <label class="field__label" for="contact-guests">{ui.form.guests}</label>
                    <div class="field__select-wrap">
                      <select class="field__select" id="contact-guests" name="guests">
                        {ui.form.guestOptions.map((option) => (
                          <option value={option.value} selected={option.value === "2"}>
                            {option.label}
                          </option>
                        ))}
                      </select>
                      <span class="field__select-icon" aria-hidden="true">
                        <Icon name="chevron-down" size={15} />
                      </span>
                    </div>
                  </div>
                </>
              ) : (
                <div class="field field--full">
                  <label class="field__label" for="contact-project">{ui.form.projectType}</label>
                  <div class="field__select-wrap">
                    <select class="field__select" id="contact-project" name="project-type">
                      {(contact.form.projectTypes ?? [ui.form.projectTypeFallback]).map((type) => (
                        <option value={type}>{type}</option>
                      ))}
                    </select>
                    <span class="field__select-icon" aria-hidden="true">
                      <Icon name="chevron-down" size={15} />
                    </span>
                  </div>
                </div>
              )}

              <div class="field field--full">
                <label class="field__label" for="contact-message">{ui.form.message}</label>
                <textarea
                  class="field__textarea"
                  id="contact-message"
                  name="message"
                  maxlength="1200"
                  required
                  placeholder={ui.form.messagePlaceholder}
                ></textarea>
              </div>
            </div>

            <div class="form-actions">
              <button class="btn btn--accent" type="submit">
                <span>{contact.form.submitLabel}</span>
                <Icon name="arrow-up-right" size={15} class="btn__icon" />
              </button>
              <span class="form-hint">{ui.form.submitHint}</span>
            </div>

            <p class="form-status" role="status" aria-live="polite" data-form-status></p>
          </form>
        </div>
      </div>
    </Section>
  )
}

<script>
  document.querySelectorAll<HTMLFormElement>("[data-demo-form]").forEach((form) => {
    const status = form.querySelector<HTMLElement>("[data-form-status]");

    form.addEventListener("input", () => {
      if (!status) return;
      status.textContent = "";
      status.classList.remove("form-status--success");
    });

    form.addEventListener("submit", (event) => {
      event.preventDefault();

      if (!form.reportValidity()) return;

      if (status) {
        status.textContent =
          form.dataset.success ||
          form.dataset.successFallback ||
          "This demo form does not send data.";
        status.classList.add("form-status--success");
      }

      form.reset();
    });
  });
</script>
