---
import type { SiteConfig } from "../../config/types";
import Button from "../ui/Button.astro";
import Section from "../ui/Section.astro";
import SectionHeading from "../ui/SectionHeading.astro";
import type { SectionSlot } from "../../lib/sections";

interface Props {
  site: SiteConfig;
  section: SectionSlot;
}

const { site, section } = Astro.props;
const pricing = site.pricing;
---

{
  pricing && (
    <Section id={section.id} labelledby={section.headingId} tone="surface">
      <SectionHeading
        eyebrow={pricing.eyebrow}
        headline={pricing.headline}
        intro={pricing.intro}
        id={section.headingId}
      />

      <div class="pricing__list">
        {pricing.plans.map((plan) => (
          <article class="plan">
            <div class="plan__main">
              <div class="plan__heading">
                <h3 class="plan__name">{plan.name}</h3>
                {plan.badge && <span class="plan__badge">{plan.badge}</span>}
              </div>
              <p class="plan__description">{plan.description}</p>
              {plan.meta && (
                <ul class="plan__meta">
                  {plan.meta.map((detail) => <li>{detail}</li>)}
                </ul>
              )}
            </div>

            <div class="plan__aside">
              <p class="plan__price">
                <span>{plan.price}</span>
                {plan.unit && <span class="plan__unit">{plan.unit}</span>}
              </p>
              {plan.action && (
                <Button {...plan.action} icon="arrow-right" class="plan__action" />
              )}
            </div>
          </article>
        ))}
      </div>

      {pricing.note && <p class="section-note">{pricing.note}</p>}

      {pricing.action && (
        <div class="pricing__cta">
          <Button {...pricing.action} />
        </div>
      )}
    </Section>
  )
}
