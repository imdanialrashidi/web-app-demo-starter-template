---
import type { SiteConfig } from "../../config/types";
import Eyebrow from "../ui/Eyebrow.astro";
import Figure from "../ui/Figure.astro";
import { pageLanguage } from "../../lib/language";
import type { SectionSlot } from "../../lib/sections";

interface Props {
  site: SiteConfig;
  section: SectionSlot;
}

const { site, section } = Astro.props;
const statement = site.statement;
const ui = pageLanguage(site).t;
const hasImage = Boolean(statement?.image?.src);
---

{
  statement && (
    <section
      id={section.id}
      class:list={["statement", hasImage && "statement--image"]}
      aria-label={statement.eyebrow}
    >
      {statement.image?.src && (
        <div class="statement__media">
          <Figure
            role="scene"
            image={statement.image.src}
            alt={statement.image.alt}
            position={statement.image.position}
            unavailableLabel={ui.imageUnavailable}
          />
        </div>
      )}

      <div class:list={["shell", "statement__inner"]}>
        <Eyebrow text={statement.eyebrow} />
        <blockquote>
          <p class="statement__quote">{statement.quote}</p>
          <footer class="statement__attribution">{statement.attribution}</footer>
        </blockquote>
      </div>

      {statement.image?.caption && hasImage && (
        <p class="statement__caption">{statement.image.caption}</p>
      )}
    </section>
  )
}
