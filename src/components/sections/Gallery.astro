---
import { getImage, Image } from "astro:assets";
import type { SiteConfig } from "../../config/types";
import Icon from "../ui/Icon.astro";
import Section from "../ui/Section.astro";
import SectionHeading from "../ui/SectionHeading.astro";
import { formatIndex, resolveUi } from "../../lib/i18n";

interface Props {
  site: SiteConfig;
}

const { site } = Astro.props;
const gallery = site.gallery;
const ui = resolveUi(site);
const locale = site.meta.locale;

const items = gallery
  ? await Promise.all(
      gallery.items.map(async (item) => {
        const full = item.image
          ? await getImage({
              src: item.image,
              width: Math.min(1800, item.image.width),
              format: "webp",
              quality: 82,
            })
          : undefined;

        return {
          ...item,
          full: full?.src,
        };
      }),
    )
  : [];
---

{
  gallery && (
    <Section id="gallery" labelledby="gallery-title">
      <SectionHeading
        eyebrow={gallery.eyebrow}
        headline={gallery.headline}
        intro={gallery.intro}
        id="gallery-title"
      />

      <div class="gallery__columns" data-gallery>
        {items.map((item) => (
          <figure class="gallery__item">
            {item.image && item.full ? (
              <button
                class="gallery__button"
                type="button"
                aria-label={`${ui.gallery.open} ${item.caption ?? item.alt}`}
                data-gallery-open
                data-full={item.full}
                data-alt={item.alt}
                data-caption={item.caption ?? ""}
              >
                <span class="gallery__image">
                  <Image
                    src={item.image}
                    alt={item.alt}
                    widths={[360, 540, 720, 1080]}
                    sizes="(min-width: 1120px) 31vw, (min-width: 560px) 47vw, 100vw"
                    format="webp"
                    quality={80}
                    loading="lazy"
                    decoding="async"
                    style={`object-position:${item.position ?? "50% 50%"}`}
                  />
                </span>
                <span class="gallery__footer">
                  <span class="gallery__caption">{item.caption}</span>
                  <span class="gallery__expand" aria-hidden="true">
                    <Icon name="expand" size={13} />
                  </span>
                </span>
              </button>
            ) : (
              <div class="gallery__image" style="aspect-ratio: 4 / 3">
                <div class="media__fallback" role="img" aria-label={`${item.alt} (${ui.imageUnavailable})`}>
                  <span class="media__fallback-mark" aria-hidden="true">—</span>
                  <span class="caption">{ui.imageUnavailable}</span>
                </div>
              </div>
            )}
          </figure>
        ))}
      </div>

      {gallery.note && <p class="gallery__note">{gallery.note}</p>}

      <dialog
        class="lightbox"
        aria-label={ui.gallery.viewer}
        data-lightbox
        data-locale={locale}
      >
        <div class="lightbox__bar">
          <span class="lightbox__counter" data-lightbox-counter aria-hidden="true">
            {formatIndex(1, locale)} / {formatIndex(items.length, locale)}
          </span>
          <button
            class="lightbox__close"
            type="button"
            aria-label={ui.gallery.close}
            data-lightbox-close
          >
            <Icon name="close" size={18} />
          </button>
        </div>
        <div class="lightbox__stage">
          <img class="lightbox__image" alt="" data-lightbox-image hidden />
        </div>
        <div class="lightbox__foot">
          <p class="lightbox__caption" data-lightbox-caption aria-live="polite"></p>
          <div class="lightbox__navs">
            <button
              class="lightbox__nav"
              type="button"
              aria-label={ui.gallery.previous}
              data-lightbox-prev
            >
              <Icon name="chevron-left" size={18} />
            </button>
            <button
              class="lightbox__nav"
              type="button"
              aria-label={ui.gallery.next}
              data-lightbox-next
            >
              <Icon name="chevron-right" size={18} />
            </button>
          </div>
        </div>
      </dialog>
    </Section>
  )
}

<script>
  const galleryRoot = document.querySelector<HTMLElement>("[data-gallery]");
  const dialog = document.querySelector<HTMLDialogElement>("[data-lightbox]");

  if (galleryRoot && dialog) {
    const triggers = Array.from(
      galleryRoot.querySelectorAll<HTMLButtonElement>("[data-gallery-open]"),
    );

    if (triggers.length) {
      const image = dialog.querySelector<HTMLImageElement>("[data-lightbox-image]");
      const caption = dialog.querySelector<HTMLElement>("[data-lightbox-caption]");
      const counter = dialog.querySelector<HTMLElement>("[data-lightbox-counter]");
      const closeButton = dialog.querySelector<HTMLButtonElement>("[data-lightbox-close]");
      const previous = dialog.querySelector<HTMLButtonElement>("[data-lightbox-prev]");
      const next = dialog.querySelector<HTMLButtonElement>("[data-lightbox-next]");

      let index = 0;

      const locale = dialog.dataset.locale || "en";
      const format = new Intl.NumberFormat(locale, {
        minimumIntegerDigits: 2,
        useGrouping: false,
      });
      const isRtl = document.documentElement.dir === "rtl";

      const render = () => {
        const trigger = triggers[index];
        if (!trigger || !image) return;

        image.src = trigger.dataset.full ?? "";
        image.alt = trigger.dataset.alt ?? "";
        image.hidden = false;

        if (caption) {
          caption.textContent = trigger.dataset.caption || trigger.dataset.alt || "";
        }
        if (counter) {
          counter.textContent = `${format.format(index + 1)} / ${format.format(triggers.length)}`;
        }
      };

      const show = (nextIndex: number) => {
        index = (nextIndex + triggers.length) % triggers.length;
        render();
      };

      triggers.forEach((trigger, triggerIndex) => {
        trigger.addEventListener("click", () => {
          show(triggerIndex);
          if (!dialog.open) dialog.showModal();
        });
      });

      closeButton?.addEventListener("click", () => dialog.close());
      previous?.addEventListener("click", () => show(index - 1));
      next?.addEventListener("click", () => show(index + 1));

      dialog.addEventListener("keydown", (event) => {
        if (event.key === "ArrowLeft") {
          event.preventDefault();
          show(index + (isRtl ? 1 : -1));
        }
        if (event.key === "ArrowRight") {
          event.preventDefault();
          show(index + (isRtl ? -1 : 1));
        }
      });

      dialog.addEventListener("click", (event) => {
        if (event.target === dialog) dialog.close();
      });

      dialog.addEventListener("close", () => {
        if (image) {
          image.hidden = true;
          image.removeAttribute("src");
        }
      });
    }
  }
</script>
