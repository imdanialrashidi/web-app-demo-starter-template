---
import type { SiteConfig } from "../../config/types";
import Button from "../ui/Button.astro";
import HeadlineText from "../ui/Headline.astro";
import Media from "../ui/Media.astro";
import { resolveUi } from "../../lib/i18n";

interface Props {
  site: SiteConfig;
}

const { site } = Astro.props;
const { hero, brand, theme } = site;
const ui = resolveUi(site);
const isImmersive = hero.variant === "immersive";
---

<section
  id="top"
  class:list={["hero", isImmersive ? "hero--immersive" : "hero--split"]}
  aria-labelledby="hero-title"
>
  {
    isImmersive ? (
      <>
        <div class="hero__media">
          <Media
            image={hero.image.src}
            alt={hero.image.alt}
            position={hero.image.position}
            class="hero__image"
            ratio="16 / 9"
            sizes="100vw"
            widths={[640, 960, 1280, 1600, 2000]}
            priority
            quality={84}
            unavailableLabel={ui.imageUnavailable}
          />
        </div>
        <div class="shell hero__immersive-inner">
          <p class="eyebrow hero__eyebrow">{hero.eyebrow}</p>
          <h1 id="hero-title" class="display display--xl hero__title">
            <HeadlineText headline={hero.headline} />
          </h1>
          <p class="hero__intro">{hero.intro}</p>
          <div class="hero__actions">
            {hero.actions.map((action) => <Button {...action} />)}
          </div>
          <dl class="hero__facts">
            {
              hero.facts.map((fact) => (
                <div class="hero__fact">
                  <dt>{fact.label}</dt>
                  <dd>{fact.value}</dd>
                </div>
              ))
            }
          </dl>
        </div>
      </>
    ) : (
      <div class="shell hero__grid">
        <div class="hero__headline">
          <p class="eyebrow hero__eyebrow">{hero.eyebrow}</p>
          <h1 id="hero-title" class="display display--xl hero__title">
            <HeadlineText headline={hero.headline} />
          </h1>
        </div>

        <div class="hero__body">
          <p class="lede hero__intro">{hero.intro}</p>
          <div class="hero__actions">
            {hero.actions.map((action) => <Button {...action} />)}
          </div>
          <dl class="hero__facts">
            {
              hero.facts.map((fact) => (
                <div class="hero__fact">
                  <dt>{fact.label}</dt>
                  <dd>{fact.value}</dd>
                </div>
              ))
            }
          </dl>
        </div>

        <div class="hero__media">
          <Media
            image={hero.image.src}
            alt={hero.image.alt}
            position={hero.image.position}
            class="hero__image"
            ratio="4 / 5"
            sizes="(min-width: 900px) 41vw, 100vw"
            widths={[480, 720, 960, 1280, 1600]}
            arch={theme.shape.heroArch}
            priority
            quality={84}
            unavailableLabel={ui.imageUnavailable}
          />
          <div class="hero__media-meta">
            <span class="hero__media-note">{hero.image.caption ?? brand.location}</span>
            <span class="hero__media-note">{brand.location}</span>
          </div>
        </div>
      </div>
    )
  }
</section>
