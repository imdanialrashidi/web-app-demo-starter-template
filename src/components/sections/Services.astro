---
import type { SiteConfig } from "../../config/types";
import Icon from "../ui/Icon.astro";
import Section from "../ui/Section.astro";
import SectionHeading from "../ui/SectionHeading.astro";
import { formatIndex } from "../../lib/i18n";

interface Props {
  site: SiteConfig;
}

const { site } = Astro.props;
const services = site.services;
---

{
  services && (
    <Section id="services" labelledby="services-title" tone="surface">
      <SectionHeading
        eyebrow={services.eyebrow}
        headline={services.headline}
        intro={services.intro}
        id="services-title"
        class="services__head"
      />

      <div class="services__grid">
        {services.items.map((service, index) => (
          <article class="service">
            <div class="service__top">
              <span class="service__icon" aria-hidden="true">
                <Icon name={service.icon} size={17} />
              </span>
              <span class="service__index" aria-hidden="true">
                {formatIndex(index + 1, site.meta.locale)}
              </span>
            </div>
            <h3 class="service__title">{service.title}</h3>
            <p class="service__description">{service.description}</p>
            {service.meta && <p class="service__meta">{service.meta}</p>}
          </article>
        ))}
      </div>

      {services.note && <p class="services__note">{services.note}</p>}
    </Section>
  )
}
