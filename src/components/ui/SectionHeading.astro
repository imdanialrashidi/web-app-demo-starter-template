---
import type { Action, Headline } from "../../config/types";
import Button from "./Button.astro";
import Eyebrow from "./Eyebrow.astro";
import HeadlineText from "./Headline.astro";

interface Props {
  eyebrow: string;
  headline: Headline;
  intro?: string;
  id: string;
  action?: Action;
  class?: string;
}

const { eyebrow, headline, intro, id, action, class: className } = Astro.props;
---

<header class:list={["section-heading", className]}>
  <div>
    <Eyebrow text={eyebrow} />
    <h2 id={id} class="display display--md section-heading__title">
      <HeadlineText headline={headline} />
    </h2>
  </div>
  {
    (intro || action) && (
      <div class="section-heading__aside">
        {intro && <p class="lede section-heading__intro">{intro}</p>}
        {action && (
          <div class="mt-6">
            <Button {...action} />
          </div>
        )}
      </div>
    )
  }
</header>
