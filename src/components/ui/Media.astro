---
import { Image } from "astro:assets";
import type { ImageMetadata } from "astro";

interface Props {
  image?: ImageMetadata;
  alt: string;
  caption?: string;
  ratio?: string;
  sizes?: string;
  widths?: number[];
  priority?: boolean;
  position?: string;
  class?: string;
  frameClass?: string;
  arch?: boolean;
  quality?: number;
  unavailableLabel?: string;
}

const {
  image,
  alt,
  caption,
  ratio = "4 / 3",
  sizes = "(min-width: 1024px) 50vw, 100vw",
  widths = [480, 800, 1200, 1600],
  priority = false,
  position = "50% 50%",
  class: className,
  frameClass,
  arch = false,
  quality = 82,
  unavailableLabel = "Image unavailable",
} = Astro.props;
---

<figure class:list={["media", arch && "media--arch", className]}>
  {
    image ? (
      <div
        class:list={["media__frame", frameClass]}
        style={`--media-ratio:${ratio}`}
      >
        <Image
          src={image}
          alt={alt}
          widths={widths}
          sizes={sizes}
          format="webp"
          quality={quality}
          loading={priority ? "eager" : "lazy"}
          decoding={priority ? "sync" : "async"}
          fetchpriority={priority ? "high" : "auto"}
          class="media__img"
          style={`object-position:${position}`}
        />
      </div>
    ) : (
      <div
        class:list={["media__frame", frameClass]}
        style={`--media-ratio:${ratio}`}
        role="img"
        aria-label={`${alt} (${unavailableLabel})`}
      >
        <div class="media__fallback">
          <span class="media__fallback-mark" aria-hidden="true">—</span>
          <span class="caption">{unavailableLabel}</span>
        </div>
      </div>
    )
  }
  {caption && <figcaption class="media__caption">{caption}</figcaption>}
</figure>
